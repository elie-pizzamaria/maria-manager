# ══════════════════════════════════════════════════════════════
# MariaManager — Variables d'environnement (exemple)
# ══════════════════════════════════════════════════════════════
#
# Copiez ce fichier en .env.local et renseignez vos valeurs.
# Le fichier .env.local ne doit JAMAIS être commité dans Git.
# ══════════════════════════════════════════════════════════════

# Clé API Zelty (clé enseigne — commune aux deux restaurants)
# Trouvable dans votre espace Zelty → Paramètres → API
ZELTY_API_KEY=

# ID Zelty du restaurant de Dax
# Trouvable dans Zelty → GET /restaurants → cherchez "Dax" → notez l'id
ZELTY_RESTAURANT_DAX=

# ID Zelty du restaurant de Mont-de-Marsan
# Trouvable dans Zelty → GET /restaurants → cherchez "Mont-de-Marsan" → notez l'id
ZELTY_RESTAURANT_MDM=
